## 6. Substituir apenas a função mapHourlyScheduleToDb em src/services/supabaseService.ts

A função atual está perto da linha 621. Os UUIDs de novos manuais devem ser gerados uma vez na criação do item. O mapper não inventa UUID nem horário.

```typescript
export function mapHourlyScheduleToDb(
  item: HourlyScheduleItem,
  itineraryDayId: string,
  tripId: string,
  index: number = 0
): Record<string, any> {
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(item.id || '')) {
    throw new Error('O item precisa de UUID estável antes de gravar: ' + item.id);
  }
  if (!/^(?:[01]\d|2[0-3]):[0-5]\d$/.test(item.time || '')) {
    throw new Error('Horário inválido: ' + item.time);
  }
  const category=item.category==='airbnb'?'hotel':item.category || 'other';
  if (!(VALID_HOURLY_CATEGORIES as readonly string[]).includes(category)) {
    throw new Error('Categoria inválida: ' + category);
  }
  return {
    id:item.id,itinerary_day_id:itineraryDayId,trip_id:tripId,time:item.time,
    title:item.title,location:item.location || null,category,completed:!!item.completed,
    notes:item.notes || null,source_type:item.sourceType || null,source_id:item.sourceId || null,
  };
}
