    const debugLogs:string[]=[];
    const addLog=(message:string)=>{debugLogs.push(message)};
    try {
      if(!tripId||!day)throw new Error('Viagem/dia ausente.');
      const {data:trip,error:tripError}=await supabase.from('trips').select('id,start_date')
        .eq('id',tripId).single();
      if(tripError||!trip)throw new Error(tripError?.message || 'Cadastre a viagem antes do roteiro.');
      let existingRow:any=null;
      const uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
      if(uuid.test(day.id || '')){
        const response=await supabase.from('itinerary_days').select('*')
          .eq('trip_id',tripId).eq('id',day.id).maybeSingle();
        if(response.error)throw new Error(response.error.message);
        existingRow=response.data;
      }
      if(!existingRow){
        const response=await supabase.from('itinerary_days').select('*')
          .eq('trip_id',tripId).eq('day_number',day.dayNumber).maybeSingle();
        if(response.error)throw new Error(response.error.message);
        existingRow=response.data;
      }
      const resolvedDayId=existingRow?.id || (uuid.test(day.id || '')?day.id:generateUUID());
      const base=trip.start_date;
      const dayDate=day.date || existingRow?.date || new Date(
        Date.parse(base+'T12:00:00Z')+(Number(day.dayNumber)-1)*86400000
      ).toISOString().slice(0,10);
      if(!/^\d{4}-\d{2}-\d{2}$/.test(dayDate))throw new Error('Data do dia inválida.');
      const fullHourlyItems:HourlyScheduleItem[]=Array.isArray(existingRow?.hourly_schedule)
        ?existingRow.hourly_schedule:[];
      const dayDb=mapItineraryDayToDb({...day,id:resolvedDayId,date:dayDate},tripId);
      // Este salvamento grava a fonte. O adaptador é o único dono da regeneração do hora a hora.
      // Manuais novos/editados usam saveHourlyScheduleItem; não entram como uma lista automática aqui.
      delete dayDb.hourly_schedule;
      const {data:written,error:dayError}=await supabase.from('itinerary_days')
        .upsert(dayDb,{onConflict:'id'}).select('id');
      if(dayError||written?.length!==1)throw new Error(dayError?.message || 'Dia não gravado.');
      // 5. Synchronize park_day_bookings table and secondary event tables for this day
