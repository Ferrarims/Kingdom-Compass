```typescript
async saveHourlyScheduleItem(
  tripId: string, itineraryDayId: string, item: HourlyScheduleItem
): Promise<{success:boolean;error?:string;rowId?:string}> {
  try {
    const row=mapHourlyScheduleToDb(item,itineraryDayId,tripId);
    const normalized:HourlyScheduleItem={...item,category:row.category};
    const {data,error}=await supabase.rpc('save_itinerary_hourly_item',{
      p_trip_id:tripId,p_day_id:itineraryDayId,p_item:normalized,
    });
    if(error)throw new Error(error.message);
    if(!data || data.success!==true || data.rowId!==item.id){
      throw new Error('O banco não confirmou a gravação do item.');
    }
    return {success:true,rowId:data.rowId};
  } catch(error:any) {
    return {success:false,error:error?.message || 'Falha ao gravar horário'};
  }
},
