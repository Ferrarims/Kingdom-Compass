### 4.3 Adicionar método específico ao contexto

Inserir a função abaixo dentro do Provider, junto de updateTrip. Manter updateTrip para os consumidores existentes; o modal “Editar Parâmetros da Viagem” usará a função nova. Não colocar efeitos de rede dentro de setTrips(previous=>...).
```ts
// Novo método do PlannerProvider. Não chamar o controlador dentro dele:
// o modal já o chama por fora, uma única vez, para evitar fila recursiva.
const updateTripParameters = async (
  id:string, changes:Partial<Trip>,
):Promise<{success:boolean;error?:string}> => {
  const existing = trips.find(trip=>trip.id === id);
  if (!existing) return {success:false,error:'Viagem não encontrada.'};
  const updates = {...changes};
  const dateFields = [
    'startDate','returnDate','flexibleOutboundStart','flexibleOutboundEnd',
    'flexibleInboundStart','flexibleInboundEnd',
  ] as const;
  for (const field of dateFields) {
    if (updates[field]) updates[field] = normalizeDateToYMD(updates[field]);
  }
  const candidate:Trip = {
    ...existing,...updates,
    settings:{...existing.settings,...updates.settings},
  };
  if ((updates.startDate !== undefined || updates.durationDays !== undefined) &&
      updates.returnDate === undefined && candidate.startDate) {
    candidate.returnDate = calculateDateOffset(candidate.startDate,candidate.durationDays - 1);
  }
  const result = await SupabaseService.saveTripParameters(candidate,updates);
  if (!result.success) return result;
  // Somente após confirmar a fonte. Não usar syncTripToSupabase neste fluxo.
  setTrips(previous=>previous.map(trip=>trip.id === id
    ? {...trip,...updates,returnDate:candidate.returnDate,settings:candidate.settings}
    : trip));
  if (activeTripId === id) {
    const headerSettings:Partial<GlobalSettings> = {};
    for (const key of [
      'tripName','destination','startDate','returnDate','durationDays','isFlexibleDates',
      'flexibleOutboundStart','flexibleOutboundEnd','flexibleInboundStart','flexibleInboundEnd',
      'outboundFlexibility','inboundFlexibility','flexibilityNotes','dollarRate',
      'totalBudgetGoalBRL','travelersCount','travelers',
    ] as const) {
      if (Object.prototype.hasOwnProperty.call(updates,key)) {
        Object.assign(headerSettings,{[key]:updates[key]});
      }
    }
    if (candidate.returnDate) headerSettings.returnDate = candidate.returnDate;
    setSettings(previous=>({...previous,...headerSettings}));
  }
  return {success:true};
};
```

Adicionar à interface do contexto:
```ts
updateTripParameters: (
  id:string, changes:Partial<Trip>
)=>Promise<{success:boolean;error?:string}>;
```

Adicionar updateTripParameters ao value do Provider.

