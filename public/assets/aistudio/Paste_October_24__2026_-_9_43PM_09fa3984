async verify(plan: Plan): Promise<void> {
  this.verified = undefined;
  const raw = await this.read(plan.tripId);
  const dates = new Set([...raw.days.map(day=>date(day.date)), ...plan.events.map(event=>event.date)]);
  for (const dayDate of dates) {
    const matches = raw.days.filter(day=>date(day.date) === dayDate);
    if (matches.length !== 1) throw new Error('Esperado um único dia persistido: ' + dayDate);
    const day = matches[0];
    const events = plan.events.filter(event=>event.date === dayDate);
    const expected = events.map(event=>event.item);
    const json = list(day.hourly_schedule || []);
    const relational = raw.hourly.filter(item=>item.itinerary_day_id === day.id);
    for (const [label,items] of [['plano',expected],['JSON',json],['tabela',relational]] as const) {
      if (new Set(items.map(item=>item.id)).size !== items.length) {
        throw new Error('IDs duplicados em ' + label + ' na data ' + dayDate);
      }
    }
    if (!sameItems(expected,json) || !sameItems(expected,relational,true)) {
      throw new Error('Verificação campo a campo falhou em ' + dayDate);
    }
    for (const event of events) {
      const stored = json.find(item=>item.id === event.item.id);
      if (!stored) throw new Error('Item não persistido: ' + event.item.id);
      assertHourlyMetadata(stored, {timeZone:event.timeZone,binding:event.binding});
    }
    if (plan.titles[dayDate] !== undefined && day.title !== plan.titles[dayDate]) {
      throw new Error('Título não persistido: ' + dayDate);
    }
  }
  this.verified = raw;
}
```

